# MongoDB connection string (local Docker or Atlas)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=resume

# Password for /admin. Signing in on a device also stops your own visits there from being counted.
ADMIN_PASSWORD=change-me

# Public address of the site. Links inside the PDF point here. Use http://localhost:3000 when testing locally.
PUBLIC_BASE_URL=https://cv.amankrverma.in
